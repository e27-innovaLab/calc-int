# Copiá este archivo a .env.local y completá los valores. NUNCA subas .env.local al repositorio.

# --- Base de datos (Neon) ---
DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Sesiones (Better Auth) ---
# 32+ caracteres aleatorios: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Envío de emails por Gmail (verificación y reseteo de contraseña) ---
# Gratis, sin dominio. Requiere una "contraseña de aplicación" de Gmail (ver docs/login-y-mail.md).
# Sin esto, en desarrollo los mails se muestran en la consola del servidor.
GMAIL_USER=tu-cuenta-del-proyecto@gmail.com
GMAIL_APP_PASSWORD=
# Opcional: nombre visible del remitente.
MAIL_FROM_NOMBRE=PRECIAR

# --- Login con Google (opcional) ---
# Redirect a registrar en Google Cloud: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Solo para habilitar las páginas de prueba en un deploy (opcional) ---
# PERMITIR_PAGINAS_DE_PRUEBA=1
